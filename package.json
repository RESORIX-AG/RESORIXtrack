{
  "name": "resorixtrack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3210 --strictPort",
    "build": "vite build",
    "start": "NODE_ENV=production node server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware && biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright install chromium && playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migration": "drizzle-kit generate --custom",
    "cli": "tsx src/cli/index.ts",
    "worker": "tsx src/worker/index.ts",
    "doctor": "pnpm dlx react-doctor@0.9.22 . --no-telemetry --no-supply-chain --verbose -y"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/api-key": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@node-rs/argon2": "2.2.2",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/charts": "1.4.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "better-auth": "1.7.18",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "croner": "11.0.0",
    "date-holidays": "3.38.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.70.0",
    "nodemailer": "10.3.1",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "srvx": "1.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@biomejs/biome": "2.6.6",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "1.167.46",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "version": "2.0.0-dev",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=26"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "@node-rs/argon2"
    ],
    "overrides": {
      "exceljs>uuid": "11.1.1"
    }
  }
}
